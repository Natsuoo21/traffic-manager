# ============================================
# Traffic Manager — Environment Configuration
# Copy to .env.development and fill in real values
# ============================================

# ---------- App ----------
APP_ENV=development
APP_PORT=3002
APP_HOST=0.0.0.0
DB_PATH=./data/traffic.db
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Meta (Facebook/Instagram Ads) ----------
# 1. Create app at developers.facebook.com → Add "Marketing API" product
# 2. App Settings > Basic → App ID + App Secret
# 3. Graph API Explorer → Generate User Token (ads_management scope)
# 4. Run: python scripts/generate_meta_token.py → Long-lived token
# 5. Graph API: GET /me/adaccounts → Account ID (format: act_XXXXXXXXX)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_API_VERSION=v21.0

# ---------- Google Ads ----------
# 1. Google Ads > Tools > API Center → Developer Token
# 2. Google Cloud Console → Create OAuth2 Desktop credentials
# 3. Run: python scripts/generate_google_refresh.py → Refresh token
# 4. Customer ID: 10-digit number from ads.google.com (no dashes)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---------- LinkedIn Ads ----------
# 1. linkedin.com/developers/apps → Create app
# 2. Products tab → Request "Marketing Developer Platform"
# 3. Auth tab → Client ID + Client Secret
# 4. Run: python scripts/generate_linkedin_token.py → Access + Refresh tokens
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=

# ---------- Alerts / Notifications (Optional) ----------
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Scheduling ----------
METRICS_SYNC_CRON=0 */6 * * *
ALERT_CHECK_CRON=0 */1 * * *
